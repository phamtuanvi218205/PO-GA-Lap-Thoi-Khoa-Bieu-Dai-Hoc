# Runtime Python đọc trực tiếp SQL Server bằng pyodbc.
# Sao chép file này thành .env tại thư mục gốc dự án, rồi sửa thông tin kết nối.
# Runtime đọc bốn khóa DB_* từ .env khi mở kết nối; biến môi trường có ưu tiên cao hơn.
# Không commit .env chứa mật khẩu. Giá trị mật khẩu có ký tự # nên đặt trong nháy đơn.
# Tạo database/bảng trước bằng Script/KHOI_TAO_DATABASE.sql, rồi đặt databaseName đúng tên đó.
# Web chỉ kết nối và thao tác dữ liệu, không tự tạo database/bảng khi khởi động.
DB_URL=jdbc:sqlserver://localhost\PHAMTUANVI;databaseName=testkhoaluan;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=123

# Không bắt buộc: runtime tự chọn Driver 18, 17 hoặc driver SQL Server có sẵn.
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Các tùy chọn GAPO_* dưới đây khai báo bằng biến môi trường của tiến trình,
# không phải cấu hình kết nối DB được đọc từ file .env.
# Số optimization run tối đa được xử lý đồng thời trong một API process.
# GAPO_RUN_WORKERS=2
# GAPO_RUN_LEASE_SECONDS=300
# GAPO_RUN_RECOVERY_INTERVAL_SECONDS=30
