# Runtime Python đọc trực tiếp SQL Server bằng pyodbc.
# Ba giá trị dưới đây cũng là mặc định cục bộ trong database.py. Chỉ cần sửa
# file môi trường khi máy triển khai dùng SQL Server hoặc tài khoản khác.
DB_URL=jdbc:sqlserver://localhost\PHAMTUANVI;databaseName=testkhoaluan;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=123

# Không bắt buộc: runtime tự chọn Driver 18, 17 hoặc driver SQL Server có sẵn.
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Số optimization run tối đa được xử lý đồng thời trong một API process.
# GAPO_RUN_WORKERS=2
# GAPO_RUN_LEASE_SECONDS=300
# GAPO_RUN_RECOVERY_INTERVAL_SECONDS=30
